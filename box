#!/bin/bash
# The IMD worker in a box. Run ./box with no arguments for the commands.
set -euo pipefail
cd "$(dirname "$0")"

IMAGE=imd-worker-box
PUBLISHED=ghcr.io/identity-md/box:latest
NAME=imd-worker
VOLUME=imd-worker-home

# Four CPUs, or as many as Docker has if fewer: Docker refuses a container that asks for more.
cpus() { local n; n=$(docker info --format '{{.NCPU}}' 2>/dev/null || echo 4); [[ "$n" =~ ^[0-9]+$ ]] && (( n < 4 )) && echo "$n" || echo 4; }

# Root inside the box only long enough to set the firewall and hand over to the `imd` user
# (entrypoint.sh); every other capability is dropped, and nothing of the Mac is mounted.
# The read jail is Claude's sandbox, built by bubblewrap from user namespaces and its own /proc.
# seccomp.json is Docker's default profile with the namespace calls allowed without CAP_SYS_ADMIN,
# and /proc is left unmasked so the jail can mount its own; a namespace's root still cannot touch
# the box's firewall (./box check proves both). IMD Agents keeps a copy (src-tauri/box-seccomp.json):
# change both.
# --init starts a small process first, to clear what jobs leave behind: the worker can't, and what
# Claude's sandbox orphans (bwrap, socat) otherwise piles up, about 50 a day, toward --pids-limit.
# It alone stays root, and a job can neither read it nor signal it.
RUN=(
  --cap-drop ALL --cap-add NET_ADMIN --cap-add SETUID --cap-add SETGID --cap-add SETPCAP --cap-add CHOWN
  --security-opt no-new-privileges:true
  --security-opt "seccomp=$(pwd)/seccomp.json" --security-opt systempaths=unconfined
  --init
  --cpus "$(cpus)" --memory 6g --pids-limit 2048
  -v "$VOLUME:/home/imd"
)

# The running worker alone, for the jury (`./box jury`): the juror's home and root's copy of the worker it runs,
# each a volume of its own, and DAC_READ_SEARCH, with which root's `imd jury enable` and `sync` read the seat and
# RPC endpoints from the worker's config, a file only the worker's user reads otherwise. Only root's few processes
# hold it; the worker drops it with every other capability, and the juror runs with none (entrypoint.sh, juror.sh).
JUROR=(--cap-add DAC_READ_SEARCH -v imd-juror-home:/var/lib/imd-juror -v imd-juror-code:/opt/imd-juror)

running() { [ "$(docker inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null)" = "true" ]; }
# What the worker runs on: claude, or claude,grok for Grok beside it on the X work. Kept beside this script.
runtime() { cat .runtime 2>/dev/null || echo claude; }

case "${1:-}" in
  build)
    docker build -t "$IMAGE" .
    ;;
  pull)
    docker pull "$PUBLISHED" && docker tag "$PUBLISHED" "$IMAGE" && echo "Downloaded the published box."
    ;;
  setup)
    running && { echo "Stop the worker first: ./box stop"; exit 1; }
    docker run -it --rm "${RUN[@]}" -e IMD_RUNTIME="$(runtime)" "$IMAGE" sh -c 'imd-box-setup && exec bash'
    ;;
  start)
    running && { echo "Already running. ./box logs to watch it."; exit 0; }
    docker rm -f "$NAME" >/dev/null 2>&1 || true
    docker run -d --name "$NAME" --restart unless-stopped "${RUN[@]}" "${JUROR[@]}" "$IMAGE" imd start --runtime "$(runtime)" --auto-update >/dev/null
    echo "Started on $(runtime). ./box logs to watch it."
    ;;
  stop)
    docker rm -f "$NAME" >/dev/null 2>&1 && echo "Stopped." || echo "Not running."
    ;;
  logs)
    docker logs -f --tail 100 "$NAME"
    ;;
  jury)
    # A seat on IMD's jury: root's `imd jury enable` in the running box, with the seat's holder signing at its link,
    # then the juror beside the worker, which the box starts at each start from then on.
    running || { echo "Start the worker first: ./box start"; exit 1; }
    docker inspect -f '{{json .HostConfig.CapAdd}}' "$NAME" | grep -q DAC_READ_SEARCH \
      || { echo "This box was started before the jury: ./box stop && ./box start, then ./box jury"; exit 1; }
    if docker exec -it -u root "$NAME" env -i HOME=/root PATH=/home/imd/.npm-global/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/foundry/bin \
        imd jury enable --worker-user imd; then
      docker exec -d -u root "$NAME" /usr/local/sbin/imd-box-juror
      echo "The juror runs beside the worker. Its log: docker exec $NAME cat /run/imd-juror-box.log"
    fi
    ;;
  status)
    if running; then docker exec -u imd "$NAME" imd doctor; else docker run --rm "${RUN[@]}" "$IMAGE" imd doctor; fi
    ;;
  shell)
    if running; then docker exec -it -u imd "$NAME" bash; else docker run -it --rm "${RUN[@]}" "$IMAGE" bash; fi
    ;;
  update)
    was=$(running && echo yes || echo no)
    [ "$was" = yes ] && "$0" stop
    docker build --pull -t "$IMAGE" .
    docker run --rm "${RUN[@]}" -e IMD_RUNTIME="$(runtime)" "$IMAGE" imd-box-setup
    [ "$was" = yes ] && "$0" start || true
    ;;
  runtime)
    want="${2:-}"
    if [ -z "$want" ]; then echo "Runs on: $(runtime)"; exit 0; fi
    # A pair needs a worker release that knows it; switching early would stop the worker.
    if [[ "$want" == *,* ]] && ! docker run --rm "${RUN[@]}" "$IMAGE" imd help 2>/dev/null | grep -q 'claude,grok'; then
      echo "This worker release can't run $want yet. It arrives with the release after Grok support merges; ./box update then. Still on $(runtime)."
      exit 1
    fi
    was=$(running && echo yes || echo no)
    [ "$was" = yes ] && "$0" stop >/dev/null
    # Grok is installed only for a runtime that uses it, and signed in before the worker starts on it.
    if [[ "$want" == *grok* ]]; then
      docker run --rm "${RUN[@]}" -e IMD_RUNTIME="$want" "$IMAGE" imd-box-setup >/dev/null
      echo "Sign in to Grok: open the link it shows and approve."
      if ! docker run -it --rm "${RUN[@]}" "$IMAGE" grok login --device-auth; then
        echo "Grok isn't signed in. Still on $(runtime)."
        [ "$was" = yes ] && "$0" start
        exit 1
      fi
    fi
    echo "$want" > .runtime
    echo "Runs on: $want"
    [ "$was" = yes ] && "$0" start || true
    ;;
  check)
    # Proves the walls hold, from inside the box: the same flags the worker runs with. The
    # router is this Mac's real default gateway, which a plain container can reach.
    router=$(route -n get default 2>/dev/null | awk '/gateway/ {print $2}')
    docker run --rm -e ROUTER="${router:-192.168.1.1}" "${RUN[@]}" "$IMAGE" bash -c '
      pass() { printf "  ok    %s\n" "$1"; }; fail() { printf "  FAIL  %s\n" "$1"; bad=1; }; bad=0
      [ "$(id -un)" = imd ] && pass "runs as imd, not root" || fail "runs as $(id -un)"
      grep -q "^CapEff:\s*0*$" /proc/self/status && pass "no capabilities" || fail "has capabilities"
      mounted=$(cut -d" " -f5 /proc/self/mountinfo | grep -E "^/(Users|Volumes|home|root|mnt|media|srv)" | grep -vx /home/imd)
      [ -z "$mounted" ] && ! ls /Users >/dev/null 2>&1 && pass "cannot see the Mac'"'"'s files" || fail "can see the Mac'"'"'s files: ${mounted:-/Users}"
      iptables -F 2>/dev/null && fail "can change the firewall" || pass "cannot change the firewall"
      timeout 4 bash -c "</dev/tcp/host.docker.internal/3306" 2>/dev/null && fail "can reach the Mac (port 3306)" || pass "cannot reach the Mac"
      timeout 4 bash -c "</dev/tcp/$ROUTER/80" 2>/dev/null && fail "can reach your router ($ROUTER)" || pass "cannot reach your router ($ROUTER)"
      timeout 4 bash -c "</dev/tcp/2606:4700:4700::1111/53" 2>/dev/null && fail "can reach the internet over IPv6" || pass "no IPv6"
      curl -fsS -m 10 -o /dev/null https://api.imd.fun/health && pass "reaches the internet (api.imd.fun)" || fail "cannot reach api.imd.fun"
      imd-browser --version >/dev/null 2>&1 && pass "the browser starts" || fail "the browser does not start"
      bwrap --ro-bind / / --dev /dev --proc /proc --unshare-all --share-net --die-with-parent /bin/true 2>/dev/null && pass "the read jail starts" || fail "the read jail does not start"
      unshare -Ur iptables -F 2>/dev/null && fail "a jailed root can change the firewall" || pass "a jailed root cannot change the firewall"
      exit $bad'
    ;;
  *)
    cat <<'EOF'
./box build    build the box image
./box pull     download the published box instead of building it
./box setup    first time: install the worker and Claude Code, sign in, pair
./box start    run the worker in the background (restarts with Docker)
./box logs     watch it
./box status   imd doctor, from inside the box
./box shell    a shell inside the box
./box check    prove it cannot see this Mac or reach it
./box update   rebuild and reinstall the CLIs, keeping logins and pairing
./box runtime  what it runs on; ./box runtime claude,grok adds Grok for X work
./box stop     stop the worker
EOF
    ;;
esac
